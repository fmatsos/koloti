# Symfony runtime
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me
SERVER_NAME=localhost

# PostgreSQL / Doctrine
POSTGRES_DB=koloti
POSTGRES_USER=koloti
POSTGRES_PASSWORD=koloti
POSTGRES_PORT=5432
DATABASE_URL="postgresql://koloti:koloti@database:5432/koloti?serverVersion=17&charset=utf8"

# HTTP runtime
HTTP_PORT=8080

# Storage
DOCUMENT_STORAGE_PATH=/app/var/storage/documents

# Messaging and mail
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
