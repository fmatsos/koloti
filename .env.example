# ==============================================================================
# Koloti — Variables d'environnement
# Copier ce fichier en .env (jamais committer .env !)
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase — PUBLIC (exposables au client navigateur)
# ------------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# ------------------------------------------------------------------------------
# Supabase — PRIVÉ (serveur uniquement — JAMAIS dans le bundle client)
# Le service_role contourne toutes les RLS. Ne JAMAIS l'exposer côté client.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# ------------------------------------------------------------------------------
# SMTP custom (Brevo / Resend — requis pour la délivrabilité)
# L'email porte tous les flux d'accès (activation, magic link, reset, convocations).
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
SMTP_FROM=noreply@mon-asl.fr
SMTP_FROM_NAME=ASL Koloti

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# URL publique de l'application (sans slash final)
PUBLIC_APP_URL=https://mon-asl.netlify.app

# Environnement : development | production
NODE_ENV=development
